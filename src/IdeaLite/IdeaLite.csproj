<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>IdeaLite</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>A small native code editor and Git workbench for Java projects.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings.en.json" LogicalName="IdeaLite.Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\JavaDark.xshd" LogicalName="IdeaLite.JavaDark.xshd" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\IdeaLite.Core\IdeaLite.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" Version="1.25.260303002" />
  </ItemGroup>
  <Target Name="ExcludeTerminalDebugSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.Terminal.Control.pdb'" /></ItemGroup>
  </Target>
</Project>
